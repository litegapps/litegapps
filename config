version=4.9
version.code=49
codename=stable
# Your name, shown in the built zip. Leave the default and the build is
# marked unofficial; the maintainer's own values live outside this file
# (the web panel keeps them in its database).
name.builder=yourname
# Set to the maintainer key for official builds; anything else is unofficial
build.status=unofficial
set.time.stamp=true
date.time=202007122239
# xz or br
compression=br
# 1-9
compression.level=1
# 1-9
zip.level=1
# true/false
zip.signer=false

# Litegapps prop
litegapps.build=true
# list-restore = lite,core,go,micro,pixel,nano,basic,user,superlite
litegapps.restore=lite
# list-type = lite,core,go,micro,pixel,nano,basic,user,superlite
litegapps.type=lite
# litegapps multi or single files.tar archive
# This function is used to create a single .tar file and is used for many variants. This speeds up the build process for many variants of pixel, micro, core, and lite.
litegapps.tar=single

# Litegappsx prop
litegappsx.build=false
# list-restore = microg
litegappsx.restore=microg
# list-type = microg
litegappsx.type=microg
