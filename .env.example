# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is gitignored (holds your SourceForge account).

# SourceForge username used for scp upload (USERNAME@web.sourceforge.net).
SF_USER=wahyu6070

# Usually no need to change the ones below.
SF_HOST=web.sourceforge.net
SF_FRS=/home/frs/project/litegapps

# What to build. Space separated.
ARCH_LIST="arm arm64 x86 x86_64"
SDK_LIST="29 30 31 32 33 34 35 36"

# Optional: force a specific SourceForge download mirror if downloads are slow
# from this VPS (leave empty to use SF's own geo-based auto-selection).
# Benchmark from THIS machine first, since the fastest mirror depends on its
# network location:
#   for m in master netactuate cytranet gigenet phoenixnap deac-fra pilotfiber excellmedia; do
#     curl -o /dev/null -s -w "$m %{time_total}s %{speed_download} B/s\n" -L -r 0-3000000 \
#       "https://$m.dl.sourceforge.net/project/litegapps/files-server/bin/bin.zip"
#   done
# SF_MIRROR=excellmedia
