# vps-build.sh
.env
vps-build-logs

# sf-build.sh Build All progress state
sf-build-progress.log

# Docker SSH credentials (never commit private keys)
docker/ssh/*
!docker/ssh/README.md
packages/files
packages/output
packages/zip-server
packages/tmp

# web/ build panel (Next.js)
web/node_modules
web/.next
web/job-logs
web/next-env.d.ts
web/tsconfig.tsbuildinfo
web/.last_deploy_hash
web/db-backups
web/db-backups.json

# The broad build-artifact names above (log, bin, output, files, tmp) have no
# leading slash, so they match at ANY depth - including app route segments
# like web/src/app/api/jobs/[id]/log/. Keep the panel source out of their way.
!web/src/
!web/src/**
web/.job.lock

# Google Drive mirror state, written by web/gdrive-mirror.sh
web/mirror-status.json
