# Copy to web/.env and fill in. This file is gitignored — it holds the admin
# password and the database credentials, so it must never be committed and
# must never be copied to the SourceForge FRS (that area is public).
#
#   cp .env.example .env

# Address the panel is opened at. Its scheme decides whether the session
# cookie is marked Secure: http:// here means a plain-http cookie.
SITE_URL=http://YOUR_VPS_IP:3020

# Where the panel listens on the host (the container itself uses 3000).
WEB_BIND=0.0.0.0
WEB_PORT=3020

# Admin account. Created on first run; changing the password here updates it.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Database. MYSQL_HOST is set by docker-compose.
MYSQL_DATABASE=litegapps
MYSQL_USER=litegapps
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host directory holding the SourceForge ssh key. Mounted read-only; only the
# key named SSH_KEY_NAME (plus known_hosts) is imported into the container.
SSH_DIR=/home/YOUR_USER/.ssh
SSH_KEY_NAME=id_rsa

# Host user that owns the checkout (`id -u` and `id -g`). Builds run as this
# user so output/, log/ and job logs are not left owned by root.
PUID=1001
PGID=1001

# Host os-release for the server page. Leave the default with regular Docker.
# With Docker installed as a snap, /etc/os-release resolves to the snap base
# (shows "Ubuntu Core 24"), so point at the host filesystem instead:
# HOST_OS_RELEASE=/var/lib/snapd/hostfs/etc/os-release

# SourceForge account, used by web/make-status.sh and the upload steps.
SF_USER=YOUR_SF_USER
